# Copy to .env for local runs (never commit the real one). On Vercel, set these under
# Project > Settings > Environment Variables.
ADMIN_PASSWORD=choose-a-password
SECRET_KEY=change-me-to-a-long-random-string

# Set automatically when you connect Neon (Marketplace) and a private Blob store to the
# Vercel project. Leave empty locally to use SQLite and a ./storage folder, or run
# `vercel env pull` to get them in .env.local.
DATABASE_URL=
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
